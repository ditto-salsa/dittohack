#define Chapter(id) "ORG ChapterDataTable+id*ChapterDataTableEntSize; PUSH; WORD 0; ORG CURRENTOFFSET+0x8; FILL ChapterDataTableEntSize-0xC; POP; EscapeMarker(255,0)"
/* Handled by tmx2ea, but I've left their definitions commented out in-case they're needed, somehow.
If you were to use these, they'd overwrite what tmx2ea puts, as tables are included last in the buildfile.
#define Object(id) "PUSH; ORG CURRENTOFFSET+0x4; BYTE id; POP"
#define Palette(id) "PUSH; ORG CURRENTOFFSET+0x6; BYTE id; POP"
#define Config(id) "PUSH; ORG CURRENTOFFSET+0x7; BYTE id; POP"
#define Map(id) "PUSH; ORG CURRENTOFFSET+0x8; BYTE id; POP"
#define Anim1(id) "PUSH; ORG CURRENTOFFSET+0x9; BYTE id; POP"
#define Anim2(id) "PUSH; ORG CURRENTOFFSET+0xA; BYTE id; POP"
#define TileChanges(id) "PUSH; ORG CURRENTOFFSET+0xB; BYTE id; POP"
*/
#define FogLevel(n) "PUSH; ORG CURRENTOFFSET+0xC; BYTE n; POP"
#define InitialCoords(x,y) "PUSH; ORG CURRENTOFFSET+0x10; BYTE x y; POP"
#define Weather(n) "PUSH; ORG CURRENTOFFSET+0x12; BYTE n; POP"
#define BattleBackgrounds(n) "PUSH; ORG CURRENTOFFSET+0x13; BYTE n; POP"
#define DifficultyAutolevels(easy, normal, hard) "PUSH; ORG CURRENTOFFSET+0x14; SHORT ((normal & 15) << 8)|((hard & 15) << 4)|(easy & 15); POP"
#define PlayerBGM(id) "PUSH; ORG CURRENTOFFSET+0x16; SHORT id; POP"
#define EnemyBGM(id) "PUSH; ORG CURRENTOFFSET+0x18; SHORT id; POP"
#define OtherBGM(id) "PUSH; ORG CURRENTOFFSET+0x1A; SHORT id; POP"
#define AllPhasesBGM(id) "PlayerBGM(id); EnemyBGM(id); OtherBGM(id)"
#define PlayerAttackBGM(id) "PUSH; ORG CURRENTOFFSET+0x1C; SHORT id; POP"
#define EnemyAttackBGM(id) "PUSH; ORG CURRENTOFFSET+0x1E; SHORT id; POP"
#define OtherAttackBGM(id) "PUSH; ORG CURRENTOFFSET+0x20; SHORT id; POP"
#define MapMusicThroughCombat "PlayerAttackBGM(0xFFFF); EnemyAttackBGM(0xFFFF); OtherAttackBGM(0xFFFF)"
#define Flag4PlayerBGM(id) "PUSH; ORG CURRENTOFFSET+0x22; SHORT id; POP"
#define Flag4EnemyBGM(id) "PUSH; ORG CURRENTOFFSET+0x24; SHORT id; POP"
#define WallHP(n) "PUSH; ORG CURRENTOFFSET+0x2C; BYTE n; POP"
#define ChapterName(textID) "PUSH; ORG CURRENTOFFSET+0x70; SHORT textID; POP"
#define Events(id) "PUSH; ORG CURRENTOFFSET+0x74; BYTE id; POP"
#define WMEvents(id) "PUSH; ORG CURRENTOFFSET+0x75; BYTE id; POP"
#define Number(n) "PUSH; ORG CURRENTOFFSET+0x80; BYTE id; POP"
#define FoesLeftForVictoryBGM(n) "PUSH; ORG CURRENTOFFSET+0x86; BYTE id; POP"
#define InitiallyDark(bool) "PUSH; ORG CURRENTOFFSET+0x87; BYTE bool; POP"
#define StatusMenuGoal(textID) "PUSH; ORG CURRENTOFFSET+0x88; SHORT textID; POP"
#define ObjectiveWindowGoal(textID) "PUSH; ORG CURRENTOFFSET+0x8A; SHORT textID; POP"
#define ChapterType(n) "PUSH; ORG CURRENTOFFSET+0x8C; BYTE n; POP"
#define DefendTurns(n) "PUSH; ORG CURRENTOFFSET+0x8D; BYTE n; POP"
#define DefendChar(id) "PUSH; ORG CURRENTOFFSET+0x8E; BYTE n; POP"
#define EscapeMarker(x,y) "PUSH; ORG CURRENTOFFSET+0x8F; BYTE x y; POP"