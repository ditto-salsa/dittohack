ThumbFunc(CheckActiveJess); CheckActiveASMC(Jess)
ThumbFunc(CheckActiveSamael); CheckActiveASMC(Samael)
ThumbFunc(CheckActiveShino); CheckActiveASMC(Shino)
ThumbFunc(CheckActiveCadaver); CheckActiveASMC(Cadaver)
ThumbFunc(CheckActiveRana); CheckActiveASMC(Rana)
ThumbFunc(CheckActiveReyne); CheckActiveASMC(Reyne)
ThumbFunc(CheckActiveSerol); CheckActiveASMC(Serol)
ThumbFunc(CheckActiveThalia); CheckActiveASMC(Thalia)
ThumbFunc(CheckActiveOrinoco); CheckActiveASMC(Orinoco)
ThumbFunc(CheckActiveCeleria); CheckActiveASMC(Celeria)
ThumbFunc(CheckActiveSimon); CheckActiveASMC(Simon)
ThumbFunc(CheckActiveLucien); CheckActiveASMC(Lucien)
ThumbFunc(CheckActivePeregrine); CheckActiveASMC(Peregrine)
