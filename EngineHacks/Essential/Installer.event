PUSH

// Skip H&S warning screen - circleseverywhere
ORG 0xCC20C
NOP

// Disable New Game music - circleseverywhere
ORG 0xC4A0C
BYTE 0

// Allow holding A for faster unit movement before game completion - Gryz
ORG 0x794EE
NOP

// Disable Mode Coefficient - Venno
ORG 0x2C474
BYTE 0

// Disable Intro Cutscene - circleseverywhere
ORG 0xC6714
NOP

// Disable Intro repeat(?) & Class Roll - Unknown
ORG 0xC63AD
BYTE 0xE0

// Skip New Game Text - circleseverywhere
ORG 0xC4928
SHORT 0x46C0

// Skip opening world map narration
ORG 0xA39768
EVBIT_MODIFY 1
SKIPWN
ENDA

// AntiHuffman hack, by Hextator and Nintenlord
#include "AntiHuffman.event"

// Animation hacks by Hextator
#include "AnimationHacks.event"

// Stop CHECK_ACTIVEID from softlocking if the ID being checked against doesn't exist
ORG 0x101E4
NOP; NOP

// Fixed enemy growths
ORG 0x2B9C4
#incbin "FixedEnemyGrowths.dmp"

// No rain or snow move costs
ORG 0x18D5A
B(EQ, 0x18D86)

POP

#include "AutoGenLeftOAM/Installer.event" // By 7743

#include "GameOptionsOnStart.lyn.event"

#include "LoadCharacterBasesForPlayersAndBosses.lyn.event"

// Bosses don't get mode bonuses/maluses
PUSH
ORG 0xF814
jumpToHack(r0, NoModeBonusesForBosses)
POP
#include "NoModeBonusesForBosses.lyn.event"

#include "ResAsMagic.event"

#include "MagicAndPhysicalTogether.lyn.event"

#include "ExtendWeaponDescBox/Installer.event" // By Vesly

#include "Statscreen/Installer.event"
#include "RText/Installer.event"
